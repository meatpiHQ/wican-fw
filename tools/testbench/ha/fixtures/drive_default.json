{
  "name": "default drive: 14 standard PIDs of ECU sim v2, every kind of signal",
  "_comment": [
    "A drive profile for ha_drive_backfill_bench.py (patterns: drive_sim.py).",
    "sim  = <mode>/<pid>/<param> of the simulator's POST /api/ecu/pids/<mode>/<pid>.",
    "row  = the AutoPID row the bench writes when the unit's own table does not",
    "       carry the parameter (--table profile / auto); the unit's standard",
    "       rows have the same names, so a unit that scanned the simulator's",
    "       car keeps its table.",
    "step = the grid a set value is rounded to; tol = how far the logged value",
    "       may be from the set one (the OBD byte's resolution).",
    "The mix on purpose: fast signals, slow ones, one that stops changing",
    "after the warm-up, one that never changes, and a counter whose value",
    "is the time itself (a missing period shows as a jump)."
  ],
  "group_period_ms": 1000,
  "parameters": [
    {"name": "EngineRPM", "sim": "01/0C/rpm", "step": 10, "tol": 0.5, "min": 0, "max": 8000,
     "pattern": {"kind": "sine", "min": 900, "max": 3400, "period_s": 300},
     "row": {"cmd": "010C", "expression": "[B3:B4]*0.25", "unit": "rpm", "class": "speed", "min": 0, "max": 16384}},
    {"name": "VehicleSpeed", "sim": "01/0D/speed", "step": 1, "tol": 0.5, "min": 0, "max": 255,
     "pattern": {"kind": "points", "repeat": true,
                 "points": [[0, 0], [40, 50], [150, 50], [180, 0], [210, 0], [270, 110], [480, 110], [540, 0], [600, 0]]},
     "row": {"cmd": "010D", "expression": "B3", "unit": "km/h", "class": "speed", "min": 0, "max": 255}},
    {"name": "CalcEngineLoad", "sim": "01/04/load", "step": 1, "tol": 0.45, "min": 0, "max": 100,
     "pattern": {"kind": "random", "min": 15, "max": 85, "hold_s": 20, "seed": 11},
     "row": {"cmd": "0104", "expression": "B3*100/255", "unit": "%", "class": "power_factor", "min": 0, "max": 100}},
    {"name": "ThrottlePosition", "sim": "01/11/throttle", "step": 1, "tol": 0.45, "min": 0, "max": 100,
     "pattern": {"kind": "walk", "min": 5, "max": 70, "max_delta": 15, "hold_s": 10, "seed": 5},
     "row": {"cmd": "0111", "expression": "B3*100/255", "unit": "%", "class": "none", "min": 0, "max": 100}},
    {"name": "MAFAirFlowRate", "sim": "01/10/maf", "step": 0.5, "tol": 0.02, "min": 0, "max": 655,
     "pattern": {"kind": "sine", "min": 3, "max": 60, "period_s": 180},
     "row": {"cmd": "0110", "expression": "[B3:B4]*0.01", "unit": "grams/sec", "class": "volume_flow_rate", "min": 0, "max": 656}},
    {"name": "IntakeManiAbsPress", "sim": "01/0B/pressure", "step": 1, "tol": 0.5, "min": 0, "max": 255,
     "pattern": {"kind": "saw", "min": 30, "max": 100, "period_s": 240},
     "row": {"cmd": "010B", "expression": "B3", "unit": "kPa", "class": "pressure", "min": 0, "max": 255}},
    {"name": "ControlModuleVolt", "sim": "01/42/voltage", "step": 0.1, "tol": 0.01, "min": 0, "max": 65,
     "pattern": {"kind": "walk", "min": 13.4, "max": 14.4, "max_delta": 0.2, "hold_s": 15, "seed": 3, "start": 13.9},
     "row": {"cmd": "0142", "expression": "[B3:B4]*0.001", "unit": "V", "class": "voltage", "min": 0, "max": 66}},
    {"name": "TimeSinceEngStart", "sim": "01/1F/seconds", "step": 1, "tol": 0.5, "min": 0, "max": 65535,
     "pattern": {"kind": "counter", "per_s": 1, "wrap": 65535},
     "row": {"cmd": "011F", "expression": "[B3:B4]", "unit": "seconds", "class": "duration", "min": 0, "max": 65535}},
    {"name": "EngineCoolantTemp", "sim": "01/05/temperature", "step": 1, "tol": 0.5, "min": -40, "max": 215,
     "pattern": {"kind": "ramp", "from": 30, "to": 92, "over_s": 900},
     "row": {"cmd": "0105", "expression": "B3-40", "unit": "degC", "class": "temperature", "min": -40, "max": 215}},
    {"name": "EngineOilTemp", "sim": "01/5C/temperature", "step": 1, "tol": 0.5, "min": -40, "max": 215,
     "pattern": {"kind": "ramp", "from": 25, "to": 105, "over_s": 1500},
     "row": {"cmd": "015C", "expression": "B3-40", "unit": "degC", "class": "temperature", "min": -40, "max": 215}},
    {"name": "IntakeAirTemperature", "sim": "01/0F/temperature", "step": 1, "tol": 0.5, "min": -40, "max": 215, "every_s": 20,
     "pattern": {"kind": "sine", "min": 22, "max": 38, "period_s": 1200},
     "row": {"cmd": "010F", "expression": "B3-40", "unit": "degC", "class": "temperature", "min": -40, "max": 215}},
    {"name": "AbsBaroPres", "sim": "01/33/pressure", "step": 1, "tol": 0.5, "min": 0, "max": 255, "every_s": 30,
     "pattern": {"kind": "steps", "values": [101, 100, 99, 98, 99, 100], "hold_s": 600},
     "row": {"cmd": "0133", "expression": "B3", "unit": "kPa", "class": "atmospheric_pressure", "min": 0, "max": 255}},
    {"name": "FuelTankLevel", "sim": "01/2F/level", "step": 1, "tol": 0.45, "min": 0, "max": 100, "every_s": 30,
     "pattern": {"kind": "ramp", "from": 80, "to": 30, "over_s": 14400},
     "row": {"cmd": "012F", "expression": "B3*100/255", "unit": "%", "class": "volume_storage", "min": 0, "max": 100}},
    {"name": "AmbientAirTemp", "sim": "01/46/temperature", "step": 1, "tol": 0.5, "min": -40, "max": 215, "every_s": 60,
     "pattern": {"kind": "const", "value": 21},
     "row": {"cmd": "0146", "expression": "B3-40", "unit": "degC", "class": "temperature", "min": -40, "max": 215}}
  ]
}
