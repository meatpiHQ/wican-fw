{
 "_comment": "WiCAN ECU Simulator \u2014 Vehicle Profile Schema v1.0",
 "_doc": {
  "encoding": "decode: value = raw * decode_scale + decode_offset  |  encode: raw = round((value - decode_offset) / decode_scale)",
  "raw": "unsigned integer, split big-endian into 'bytes' bytes, placed at data_byte_offset in the response payload",
  "web_control elements": [
   "slider",
   "switch",
   "dropdown",
   "number_input",
   "text_input"
  ],
  "multi_frame": "All responses use ISO-TP. Payloads > 7 bytes are automatically segmented into FF+CF frames. No special flag needed.",
  "error_sim": {
   "note": "Optional field on any PID entry. Absent or enabled=false means normal responses.",
   "response_type values": [
    "negative_response",
    "no_response",
    "response_pending"
   ],
   "trigger values": [
    "single",
    "continuous",
    "intermittent"
   ],
   "nrc common codes": {
    "0x10": "generalReject",
    "0x11": "serviceNotSupported",
    "0x22": "conditionsNotCorrect",
    "0x31": "requestOutOfRange",
    "0x33": "securityAccessDenied",
    "0x78": "requestCorrectlyReceivedResponsePending"
   }
  }
 },
