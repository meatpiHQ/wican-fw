# Custom board (ESP32-S3-WROOM-1 N16R8: 16MB quad flash, 8MB octal PSRAM).
# SPIRAM settings taken from the known-good WiCAN Pro S3 sdkconfig.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="wican_partitions_table_16mb.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=128
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y

# Keep ALL networking on core 0. By default lwip's tcpip_thread (prio 18) has
# no core affinity, so under GVRET/SavvyCAN streaming it migrates to core 1
# and preempts the mcp2515_intr task, stalling the bus-1 TX restart path.
# Core 1 is the CAN datapath core.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
