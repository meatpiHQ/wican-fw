{
    "title": "WiCan Vehicle Profile",
    "description": "Data about various models of cars and their settings",
    "type": "object",
    "properties": {
        "car_model": {
            "description": "Name of car model, should include Make and Model(s)",
            "type": "string"
        },
        "init": {
            "description": "Init String, don't forget the final ;",
            "type": "string"
        },
        "pids": {
            "description": "Array of PID's and their parameters",
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["pid"],
                "properties": {
                    "pid": {
                        "description": "The PID for this group of parameters",
                        "type": "string"
                    },
                    "parameters": {
                        "description": "Array of Parameters for this PID",
                        "type": "array",
                        "minItems": 1,
                        "items": { "$ref": "#/$defs/parameter" }
                    }
                }
            }
        },
        "can_filters": {
            "description": "Passive broadcast CAN frames to monitor (no polling)",
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["frame_id", "parameters"],
                "properties": {
                    "frame_id": {
                        "description": "CAN frame ID to match, hex string e.g. 0x201",
                        "type": "string"
                    },
                    "parameters": {
                        "description": "Parameters decoded from this frame's data bytes (B0 = first data byte)",
                        "type": "array",
                        "minItems": 1,
                        "items": { "$ref": "#/$defs/parameter" }
                    }
                }
            }
        }
    },
    "$defs": {
        "parameter": {
            "type": "object",
            "required": ["name", "expression", "unit", "class"],
            "properties": {
                "name": {
                    "description": "Used in MQTT JSON, no spaces",
                    "type": "string"
                },
                "expression": {
                    "description": "Expression to calculate value",
                    "type": "string"
                },
                "unit": {
                    "description": "Unit for this  parameter",
                    "type": "string"
                },
                "class": {
                    "description": "Class of sensor, See Home Assistant sensor classes",
                    "type": "string"
                },
                "period": {
                    "description": "Minimum update period in ms (optional, default 5000)",
                    "type": "number"
                }
            }
        }
    },
    "additionalProperties": false,
    "required": [ "car_model", "init", "pids"]
}